# The gateway reads all configuration from real environment variables
# (docker-compose.yml). It boots without a .env file; this lists what it reads.
APP_NAME=studentos-gateway
APP_ENV=production
APP_DEBUG=false
APP_KEY=

LOG_CHANNEL=stderr
CACHE_STORE=file

# Shared HS256 secret, at least 32 characters. Same value as the Auth Service.
JWT_SECRET=

AUTH_SERVICE_URL=http://auth:8000
CALENDAR_SERVICE_URL=http://calendar:8000
FINANCE_SERVICE_URL=http://finance:8000
NOTES_SERVICE_URL=http://notes:8000
