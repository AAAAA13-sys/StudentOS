<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/finance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_ponpon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="Ponpon the cat"
        android:src="@drawable/ponpon_happy" />

    <LinearLayout 
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Safe to spend today"
            android:layout_marginEnd="48dp"
            android:textColor="#6D28D9"
            android:textSize="12sp"
            android:textStyle="bold" />
    
        <TextView
            android:id="@+id/finance_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="—"
            android:textColor="#0F172A"
            android:textSize="28sp"
            android:textStyle="bold" />
    
        <TextView
            android:id="@+id/finance_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#475569"
            android:textSize="13sp" />
    
    </LinearLayout>

</FrameLayout>
