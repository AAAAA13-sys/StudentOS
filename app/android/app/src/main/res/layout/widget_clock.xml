<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_ponpon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="Ponpon the cat"
        android:src="@drawable/ponpon_happy" />

    <LinearLayout 
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    
        <LinearLayout
            android:id="@+id/clock_alarm_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
    
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Next alarm"
            android:layout_marginEnd="48dp"
                android:textColor="#6D28D9"
                android:textSize="12sp"
                android:textStyle="bold" />
    
            <TextView
                android:id="@+id/clock_alarm_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="No alarm set"
                android:textColor="#0F172A"
                android:textSize="24sp"
                android:textStyle="bold" />
    
            <TextView
                android:id="@+id/clock_alarm_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#475569"
                android:textSize="13sp" />
        </LinearLayout>
    
        <TextView
            android:id="@+id/clock_start_focus"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:text="Start focus"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    
        <LinearLayout
            android:id="@+id/clock_focus_running"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/widget_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">
    
            <TextView
                android:id="@+id/clock_focus_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#25134D"
                android:textSize="13sp" />
    
            <Chronometer
                android:id="@+id/clock_focus_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="#25134D"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    
    </LinearLayout>

</FrameLayout>
